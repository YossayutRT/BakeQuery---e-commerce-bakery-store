@model _66033872_Yossayut_rutatip.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    var vm = Model ?? new _66033872_Yossayut_rutatip.ViewModels.ForgotPasswordViewModel();
    var hasMockOtp = !string.IsNullOrWhiteSpace(vm.MockOtp);
    var firstError = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .FirstOrDefault(m => !string.IsNullOrWhiteSpace(m));
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - BakeQuery</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Auth-Extended.css" />
</head>
<body>
    @if (!string.IsNullOrWhiteSpace(firstError))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
            <div id="authToast" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@firstError</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <div class="auth-page">
        <a href="~/Account/Login" class="back-home-btn">← <span style="margin-left:8px;">Back to Login</span></a>

        <div class="auth-container reverse">
            <div class="auth-banner register-bg">
                <div class="banner-content">
                    <h1>Reset Password</h1>
                    <p>ตั้งรหัสผ่านใหม่</p>
                </div>
            </div>

            <div class="auth-form-wrapper">
                <div class="form-header">
                    <h2>Forgot Password</h2>
                    <p class="sub-text">กรอกอีเมล ตั้งรหัสผ่านใหม่ และยืนยัน OTP (Mock)</p>
                </div>

                <div id="otpInfoBox" class="alert alert-warning py-2 px-3 @(hasMockOtp ? string.Empty : "d-none")" role="alert" style="font-size:0.9rem; border-radius:12px;">
                    OTP : <strong id="otpCodeText">@vm.MockOtp</strong>
                </div>

                <div id="otpMessageBox" class="alert d-none py-2 px-3" role="alert" style="font-size:0.9rem; border-radius:12px;"></div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="auth-input-group">
                        <label>อีเมล</label>
                        <div class="auth-input-field">
                            <input type="email" asp-for="Email" placeholder="name@example.com" autocomplete="email" />
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label>รหัสผ่านใหม่</label>
                        <div class="auth-input-field">
                            <input type="password" asp-for="NewPassword" placeholder="อย่างน้อย 6 ตัวอักษร" autocomplete="new-password" />
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label>ยืนยันรหัสผ่านใหม่</label>
                        <div class="auth-input-field">
                            <input type="password" asp-for="ConfirmPassword" placeholder="พิมพ์รหัสผ่านใหม่อีกครั้ง" autocomplete="new-password" />
                        </div>
                    </div>

                    <div class="auth-input-group">
                        <label>OTP </label>
                        <div class="auth-input-field">
                            <input type="text" asp-for="OtpCode" placeholder="กรอกรหัส OTP 6 หลัก" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" />
                        </div>
                    </div>

                    <button type="button" id="requestOtpBtn" class="btn-submit" style="margin-top:20px; background:#e9aa47;">ขอ OTP <span style="margin-left:8px;">→</span></button>
                    <button type="submit" class="btn-submit" style="margin-top:10px;">ยืนยัน OTP และเปลี่ยนรหัสผ่าน <span style="margin-left:8px;">→</span></button>
                </form>

                <div class="auth-footer">
                    <p>จำรหัสผ่านได้แล้ว? <a href="~/Account/Login">กลับไปเข้าสู่ระบบ</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (!string.IsNullOrWhiteSpace(firstError))
    {
        <script>
            (function () {
                const toastEl = document.getElementById('authToast');
                if (!toastEl || !window.bootstrap) return;
                new bootstrap.Toast(toastEl, { delay: 2600 }).show();
            })();
        </script>
    }

    <script>
        (function () {
            const form = document.querySelector('form[asp-action="ForgotPassword"], form[action*="/Account/ForgotPassword"]') || document.querySelector('form');
            const requestOtpBtn = document.getElementById('requestOtpBtn');
            const otpInfoBox = document.getElementById('otpInfoBox');
            const otpCodeText = document.getElementById('otpCodeText');
            const otpMessageBox = document.getElementById('otpMessageBox');

            if (!form || !requestOtpBtn) return;

            const emailInput = form.querySelector('input[name="Email"]');
            const newPasswordInput = form.querySelector('input[name="NewPassword"]');
            const confirmPasswordInput = form.querySelector('input[name="ConfirmPassword"]');

            const showMessage = function (message, isSuccess) {
                if (!otpMessageBox) return;
                otpMessageBox.classList.remove('d-none', 'alert-danger', 'alert-success');
                otpMessageBox.classList.add(isSuccess ? 'alert-success' : 'alert-danger');
                otpMessageBox.textContent = message || '';
            };

            requestOtpBtn.addEventListener('click', async function () {
                const payload = new URLSearchParams();
                payload.set('Email', (emailInput?.value || '').trim());
                payload.set('NewPassword', (newPasswordInput?.value || '').trim());
                payload.set('ConfirmPassword', (confirmPasswordInput?.value || '').trim());

                requestOtpBtn.disabled = true;
                const originalLabel = requestOtpBtn.innerHTML;
                requestOtpBtn.innerHTML = 'กำลังสร้าง OTP...';

                try {
                    const response = await fetch('/Account/RequestForgotPasswordOtp', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: payload.toString()
                    });

                    const result = await response.json();
                    if (!response.ok || !result || result.success !== true) {
                        showMessage(result?.message || 'ไม่สามารถขอ OTP ได้', false);
                        return;
                    }

                    if (otpCodeText) {
                        otpCodeText.textContent = result.mockOtp || '';
                    }
                    if (otpInfoBox) {
                        otpInfoBox.classList.remove('d-none');
                    }

                    showMessage(result.message || 'สร้าง OTP แล้ว', true);
                } catch {
                    showMessage('เกิดข้อผิดพลาดระหว่างขอ OTP กรุณาลองใหม่', false);
                } finally {
                    requestOtpBtn.disabled = false;
                    requestOtpBtn.innerHTML = originalLabel;
                }
            });
        })();
    </script>
</body>
</html>

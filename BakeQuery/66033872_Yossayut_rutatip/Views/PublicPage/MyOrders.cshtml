<script>
    (function () {
        const cancelModal = document.getElementById('cancelOrderModal');
        if (!cancelModal) return;

        const orderIdInput = document.getElementById('cancelOrderIdInput');
        const reasonInput = document.getElementById('cancelReasonInput');
        const targetText = document.getElementById('cancelOrderTargetText');
        const otherWrap = document.getElementById('cancelOtherReasonWrap');
        const otherText = document.getElementById('cancelOtherReasonText');
        const cancelForm = document.getElementById('cancelOrderForm');

        cancelModal.addEventListener('show.bs.modal', function (event) {
            const trigger = event.relatedTarget;
            if (!trigger) return;

            const orderId = trigger.getAttribute('data-order-id') || '';
            const orderNo = trigger.getAttribute('data-order-no') || '';

            orderIdInput.value = orderId;
            targetText.textContent = orderNo ? `ออเดอร์ ${orderNo}` : 'เลือกรายการที่ต้องการยกเลิก';
            reasonInput.value = '';

            cancelForm.querySelectorAll('input[name="cancelReasonPreset"]').forEach(function (item) {
                item.checked = false;
            });

            otherText.value = '';
            otherWrap.style.display = 'none';
            otherText.required = false;
        });

        cancelForm.querySelectorAll('input[name="cancelReasonPreset"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                const isOther = radio.value === 'OTHER' && radio.checked;
                otherWrap.style.display = isOther ? '' : 'none';
                otherText.required = isOther;
                if (!isOther) {
                    otherText.value = '';
                }
            });
        });

        cancelForm.addEventListener('submit', function (event) {
            const selected = cancelForm.querySelector('input[name="cancelReasonPreset"]:checked');
            if (!selected) {
                event.preventDefault();
                alert('กรุณาเลือกเหตุผลในการยกเลิก');
                return;
            }

            if (selected.value === 'OTHER') {
                const customReason = (otherText.value || '').trim();
                if (!customReason) {
                    event.preventDefault();
                    alert('กรุณาระบุเหตุผลเพิ่มเติม');
                    otherText.focus();
                    return;
                }

                reasonInput.value = customReason;
                return;
            }

            reasonInput.value = selected.value;
        });
    })();
</script>

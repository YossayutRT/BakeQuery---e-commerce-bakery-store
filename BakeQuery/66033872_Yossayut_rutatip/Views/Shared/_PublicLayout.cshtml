<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BakeQuery</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<style>
    html, body {
        height: 100%;
    }

    body.public-layout-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: 'Noto Sans Thai', sans-serif;
    }

    .public-main-content {
        flex: 1 0 auto;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.35s ease, transform 0.35s ease;
    }

    body.is-page-ready .public-main-content {
        opacity: 1;
        transform: none;
    }

    .public-top-navbar {
        border-bottom: 1px solid rgba(107, 63, 43, 0.12);
    }

    .public-top-navbar .navbar-brand {
        font-family: 'Playfair Display', serif;
        letter-spacing: 0.2px;
        color: #2f241a;
    }

    .public-top-navbar .nav-link {
        font-weight: 600;
        color: #5b4a3b;
        border-radius: 10px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .public-top-navbar .nav-link:hover {
        color: #4b3422;
        background: rgba(185, 137, 85, 0.12);
    }

    .public-top-navbar .nav-link.active {
        color: #4b3422;
        background: rgba(185, 137, 85, 0.18);
    }

    .public-cart-link {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid rgba(72, 122, 255, 0.32);
        color: #3c83ff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(60, 131, 255, 0.07);
        text-decoration: none;
    }

    .public-cart-link:hover {
        color: #2f73e6;
        background: rgba(60, 131, 255, 0.14);
    }

    @@media (max-width: 991.98px) {
        .public-top-navbar {
            padding: 0.65rem 1rem;
        }

        .public-top-navbar .navbar-toggler {
            border-radius: 12px;
            border-color: rgba(107, 63, 43, 0.38);
            box-shadow: none;
            padding: 0.34rem 0.56rem;
        }

        .public-top-navbar .navbar-collapse {
            margin-top: 0.8rem;
            padding: 0.82rem;
            border-radius: 16px;
            border: 1px solid rgba(107, 63, 43, 0.14);
            background: linear-gradient(180deg, #ffffff 0%, #f9f4ed 100%);
            box-shadow: 0 10px 26px rgba(33, 22, 14, 0.09);
        }

        .public-top-navbar .navbar-nav {
            gap: 0.24rem !important;
        }

        .public-top-navbar .nav-link {
            padding: 0.56rem 0.74rem;
            font-size: 1rem;
        }

        .public-nav-actions {
            margin-top: 0.7rem;
            border-top: 1px dashed rgba(107, 63, 43, 0.2);
            padding-top: 0.7rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.45rem !important;
        }

        .public-nav-actions .btn {
            border-radius: 10px;
            padding: 0.42rem 0.8rem;
            font-weight: 700;
        }
    }

    .page-loader {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(circle at 15% 20%, rgba(255, 245, 228, 0.95) 0%, rgba(255, 245, 228, 0) 38%),
            radial-gradient(circle at 82% 78%, rgba(236, 203, 164, 0.5) 0%, rgba(236, 203, 164, 0) 40%),
            linear-gradient(160deg, #fff8ef 0%, #f7ebdd 46%, #f2e2cf 100%);
        opacity: 1;
        visibility: visible;
        transition: opacity 0.28s ease, visibility 0.28s ease;
    }

    .page-loader.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .page-loader-card {
        min-width: 260px;
        text-align: center;
        padding: 22px 24px 18px;
        border-radius: 22px;
        border: 1px solid rgba(146, 107, 67, 0.26);
        background: linear-gradient(165deg, rgba(255, 253, 250, 0.95) 0%, rgba(252, 245, 236, 0.93) 100%);
        box-shadow: 0 18px 42px rgba(89, 57, 27, 0.19), inset 0 1px 0 rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        position: relative;
        overflow: hidden;
    }

    .page-loader-card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #d2a269 0%, #b98344 50%, #d2a269 100%);
    }

    .page-loader-badge {
        width: 82px;
        height: 82px;
        margin: 0 auto;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 2px solid rgba(187, 137, 85, 0.35);
        background: radial-gradient(circle, #fffdf9 0%, #f9eee1 100%);
        box-shadow: inset 0 0 0 6px rgba(255, 255, 255, 0.58);
        position: relative;
    }

    .page-loader-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 3px solid rgba(185, 137, 85, 0.25);
        border-top-color: #b57a42;
        animation: loaderRing 1s linear infinite;
    }

    .page-loader-logo {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #d9bc98;
        box-shadow: 0 6px 14px rgba(102, 69, 37, 0.2);
        animation: loaderPulse 1.4s ease-in-out infinite;
    }

    .page-loader-title {
        margin-top: 10px;
        color: #5e3d21;
        font-family: 'Playfair Display', serif;
        font-size: 1.45rem;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .page-loader-subtitle {
        margin-top: 2px;
        color: #86664a;
        font-size: 0.84rem;
        font-weight: 600;
    }

    .page-loader-progress {
        margin: 12px auto 0;
        width: 100%;
        height: 5px;
        border-radius: 999px;
        background: rgba(182, 132, 76, 0.17);
        overflow: hidden;
    }

    .page-loader-progress span {
        display: block;
        width: 45%;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #c7965e 0%, #b57a42 100%);
        animation: loaderProgress 1.2s ease-in-out infinite;
    }

    .page-loader-dots {
        margin-top: 10px;
        display: inline-flex;
        gap: 6px;
    }

    .page-loader-dots span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #b98955;
        opacity: 0.35;
        animation: dotBlink 1s ease-in-out infinite;
    }

    .page-loader-dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .page-loader-dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes loaderPulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.07); }
        100% { transform: scale(1); }
    }

    @@keyframes loaderRing {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@keyframes loaderProgress {
        0% { transform: translateX(-130%); }
        50% { transform: translateX(60%); }
        100% { transform: translateX(210%); }
    }

    @@keyframes dotBlink {
        0%, 100% { opacity: 0.28; transform: translateY(0); }
        50% { opacity: 1; transform: translateY(-2px); }
    }

    .public-site-footer {
        margin-top: 0;
        background: linear-gradient(145deg, #2e2116 0%, #1f1710 100%);
        color: #e9dac8;
        border-top: 1px solid #3b2a1c;
        flex-shrink: 0;
    }

    .public-site-footer a {
        color: #f0dfca;
        text-decoration: none;
    }

    .public-site-footer a:hover {
        color: #ffd8a8;
    }

    .public-footer-main {
        padding: 2.2rem 0 1.4rem;
    }

    .public-footer-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 0.7rem;
        color: #ffddaf;
        font-weight: 800;
        letter-spacing: 0.3px;
    }

    .public-footer-brand img {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(255, 216, 168, 0.35);
        background: #fff;
    }

    .public-footer-text {
        color: #d9c8b3;
        font-size: 0.92rem;
        line-height: 1.6;
        max-width: 420px;
    }

    .public-footer-title {
        color: #ffddaf;
        font-size: 0.96rem;
        font-weight: 800;
        margin-bottom: 0.75rem;
        letter-spacing: 0.25px;
    }

    .public-footer-links {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .public-footer-links a,
    .public-footer-contact-item {
        font-size: 0.9rem;
        color: #e7d8c5;
    }

    .public-footer-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        line-height: 1.5;
    }

    .public-footer-social {
        display: flex;
        gap: 8px;
        margin-top: 0.65rem;
    }

    .public-footer-social a {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 224, 183, 0.08);
        border: 1px solid rgba(255, 216, 168, 0.26);
        transition: all 0.2s ease;
    }

    .public-footer-social a:hover {
        background: rgba(255, 224, 183, 0.2);
        border-color: rgba(255, 216, 168, 0.48);
        transform: translateY(-1px);
    }

    .public-footer-bottom {
        border-top: 1px solid rgba(255, 216, 168, 0.14);
        padding: 0.95rem 0 1rem;
        color: #b8a287;
        font-size: 0.82rem;
    }

    @@media (max-width: 768px) {
        .public-footer-main {
            padding-top: 1.6rem;
        }

        .public-footer-text {
            max-width: none;
        }
    }
</style>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isHome = currentController == "Account" && currentAction == "HomePage";
    var isMenu = currentController == "PublicPage" && currentAction == "Menu";
    var isPromo = currentController == "PublicPage" && currentAction == "Promotion";
    var isCart = currentController == "PublicPage" && currentAction == "Cart";
    var isMyOrders = currentController == "PublicPage" && currentAction == "MyOrders";
    var isOrderHistory = currentController == "PublicPage" && currentAction == "OrderHistory";
    var isProfile = currentController == "Account" && currentAction == "Profile";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isBackOfficeRole = User.IsInRole("MANAGER") || User.IsInRole("ADMIN") || User.IsInRole("STAFF");
    var isCustomer = User.IsInRole("CUSTOMER");
    var cartToast = TempData["CartToast"]?.ToString();
    var orderSuccessToast = TempData["OrderSuccess"]?.ToString();
}

<body class="public-layout-shell @(isHome ? "home-mobile-nav" : string.Empty)">

    <div id="pageLoader" class="page-loader is-hidden" aria-live="polite" aria-busy="true">
        <div class="page-loader-card">
            <div class="page-loader-badge" aria-hidden="true">
                <span class="page-loader-ring"></span>
                <img src="~/image/BakeQuery_Logo.png" alt="BakeQuery" class="page-loader-logo" />
            </div>
            <div class="page-loader-title">BakeQuery</div>
            <div class="page-loader-subtitle">Preparing something delicious</div>
            <div class="page-loader-progress" aria-hidden="true"><span></span></div>
            <div class="page-loader-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-4 public-top-navbar">
        <img src="~/image/BakeQuery_Logo.png" alt="BakeQuery Logo" class="img-fluid" width="50" height="50">
            <a class="navbar-brand fw-bold" href="#">BakeQuery</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto gap-3">
                    <li class="nav-item"><a class="nav-link @(isHome ? "active" : "")" asp-controller="Account" asp-action="HomePage">Home</a></li>
                    <li class="nav-item"><a class="nav-link @(isMenu ? "active" : "")" asp-controller="PublicPage" asp-action="Menu">Menu</a></li>
                    <li class="nav-item"><a class="nav-link @(isPromo ? "active" : "")" asp-controller="PublicPage"
                                                asp-action="Promotion">Promotions</a></li>
                    @if (isAuthenticated && isCustomer)
                    {
                        <li class="nav-item"><a class="nav-link @(isMyOrders ? "active" : "")" asp-controller="PublicPage" asp-action="MyOrders">My Orders</a></li>
                        <li class="nav-item"><a class="nav-link @(isOrderHistory ? "active" : "")" asp-controller="PublicPage" asp-action="OrderHistory">Order History</a></li>
                    }
                    </ul>

                    <div class="d-flex align-items-center gap-3 public-nav-actions">
                        <a asp-controller="PublicPage" asp-action="Cart" title="ตะกร้าสินค้า" class="position-relative public-cart-link" aria-label="Cart">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag"
                                 viewBox="0 0 16 16">
                                <path
                                d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z" />
                            </svg>
                            <span id="cartCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;display:none;"></span>
                        </a>

                        @if (isAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary">
                                <b>@(User.Identity?.Name ?? "Profile")</b>
                            </a>

                            @if (isBackOfficeRole)
                            {
                                <a asp-controller="BackOffice" asp-action="OrderMenu" class="btn btn-outline-dark">Back Office</a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning"><b>Logout</b></button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-warning">
                                <b>Login</b>
                            </a>
                        }
                    </div>
                </div>
            </nav>

            <nav class="mobile-bottom-nav @(!(isAuthenticated && isCustomer) ? "mobile-bottom-nav--guest" : string.Empty)" aria-label="Mobile bottom navigation">
                <a class="mobile-nav-item @(isHome ? "active" : "")" asp-controller="Account" asp-action="HomePage">
                    <i class="fa-solid fa-house"></i>
                    <span>Home</span>
                </a>
                <a class="mobile-nav-item @(isMenu ? "active" : "")" asp-controller="PublicPage" asp-action="Menu">
                    <i class="fa-solid fa-utensils"></i>
                    <span>Menu</span>
                </a>
                <a class="mobile-nav-item @(isPromo ? "active" : "")" asp-controller="PublicPage" asp-action="Promotion">
                    <i class="fa-solid fa-tags"></i>
                    <span>Promo</span>
                </a>
                @if (isAuthenticated && isCustomer)
                {
                    <a class="mobile-nav-item @(isMyOrders ? "active" : "")" asp-controller="PublicPage" asp-action="MyOrders">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Orders</span>
                    </a>
                    <a class="mobile-nav-item @(isOrderHistory ? "active" : "")" asp-controller="PublicPage" asp-action="OrderHistory">
                        <i class="fa-solid fa-box-archive"></i>
                        <span>History</span>
                    </a>
                }
            </nav>
            <main class="public-main-content">
                @RenderBody()
            </main>

            <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
                @if (!string.IsNullOrWhiteSpace(cartToast) || !string.IsNullOrWhiteSpace(orderSuccessToast))
                {
                    <div id="appToast" class="toast align-items-center border-0 text-bg-dark" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                @(cartToast ?? orderSuccessToast)
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                }
                <div id="ajaxToast" class="toast align-items-center border-0 text-bg-dark" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body" id="ajaxToastBody"></div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            </div>
            <footer class="public-site-footer">
                <div class="container public-footer-main">
                    <div class="row g-4">
                        <div class="col-12 col-lg-5">
                            <div class="public-footer-brand">
                                <img src="~/image/BakeQuery_Logo.png" alt="BakeQuery" />
                                <span>BakeQuery</span>
                            </div>
                            <p class="public-footer-text mb-0">
                                Handmade bakery for everyday happiness. เราคัดวัตถุดิบอย่างดีและอบสดใหม่ทุกวัน
                                เพื่อให้ทุกคำเป็นช่วงเวลาพิเศษของคุณ
                            </p>
                        </div>

                        <div class="col-6 col-md-3 col-lg-2">
                            <div class="public-footer-title">Explore</div>
                            <div class="public-footer-links">
                                <a asp-controller="Account" asp-action="HomePage">Home</a>
                                <a asp-controller="PublicPage" asp-action="Menu">Menu</a>
                                <a asp-controller="PublicPage" asp-action="Promotion">Promotions</a>
                                <a asp-controller="PublicPage" asp-action="Cart">Cart</a>
                            </div>
                        </div>

                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="public-footer-title">Customer</div>
                            <div class="public-footer-links">
                                <a asp-controller="PublicPage" asp-action="MyOrders">My Orders</a>
                                <a asp-controller="PublicPage" asp-action="OrderHistory">Order History</a>
                                <a asp-controller="Account" asp-action="Profile">Profile</a>
                                <a asp-controller="Account" asp-action="Login">Login</a>
                            </div>
                        </div>

                        <div class="col-12 col-md-5 col-lg-2">
                            <div class="public-footer-title">Contact</div>
                            <div class="public-footer-contact-item"><i class="fa-solid fa-location-dot mt-1"></i><span>Bangkok, Thailand</span></div>
                            <div class="public-footer-contact-item"><i class="fa-solid fa-phone mt-1"></i><span>+66 61 625 1425</span></div>
                            <div class="public-footer-contact-item"><i class="fa-solid fa-envelope mt-1"></i><span>yossayut.r@gmail.com</span></div>
                            <div class="public-footer-social">
                                <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                                <a href="#" aria-label="Line"><i class="fa-brands fa-line"></i></a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="public-footer-bottom">
                    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
                        <span>&copy; @DateTime.Now.Year BakeQuery. All rights reserved.</span>
                        <span>Freshly baked • Crafted with care</span>
                    </div>
                </div>
            </footer>
                <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                @if (!string.IsNullOrWhiteSpace(cartToast) || !string.IsNullOrWhiteSpace(orderSuccessToast))
                {
                    <script>
                        (function () {
                            const toastEl = document.getElementById('appToast');
                            if (!toastEl || !window.bootstrap) return;
                            const toast = new bootstrap.Toast(toastEl, { delay: 1800 });
                            toast.show();
                        })();
                    </script>
                }
                <script>
                    function showAjaxToast(message) {
                        const toastEl = document.getElementById('ajaxToast');
                        if (!toastEl || !window.bootstrap) return;
                        document.getElementById('ajaxToastBody').textContent = message;
                        const toast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 1800 });
                        toast.show();
                    }
                    function updateCartBadge(count) {
                        const badge = document.getElementById('cartCountBadge');
                        if (!badge) return;
                        if (count > 0) {
                            badge.textContent = count > 99 ? '99+' : count;
                            badge.style.display = '';
                        } else {
                            badge.style.display = 'none';
                        }
                    }

                    (function () {
                        const loader = document.getElementById('pageLoader');
                        const navLoaderKey = 'bq_show_loader_on_next_page';
                        const shouldShowLoaderOnEnter = sessionStorage.getItem(navLoaderKey) === '1';
                        sessionStorage.removeItem(navLoaderKey);

                        const hideLoader = function () {
                            if (!loader) return;
                            loader.classList.add('is-hidden');
                            document.body.classList.remove('page-transitioning');
                            document.body.classList.add('is-page-ready');
                        };

                        const showLoader = function () {
                            if (!loader) return;
                            loader.classList.remove('is-hidden');
                            document.body.classList.add('page-transitioning');
                        };

                        if (shouldShowLoaderOnEnter) {
                            showLoader();
                        } else {
                            hideLoader();
                        }

                        window.addEventListener('load', function () {
                            setTimeout(hideLoader, 240);
                        });

                        // Fallback in case load event is delayed.
                        setTimeout(hideLoader, 1600);

                        document.addEventListener('click', function (event) {
                            const link = event.target.closest('a');
                            if (!link) return;
                            if (event.defaultPrevented) return;
                            if (event.button !== 0) return;
                            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                            if (link.target && link.target.toLowerCase() === '_blank') return;
                            if (link.hasAttribute('download')) return;

                            const href = link.getAttribute('href');
                            if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

                            const url = new URL(link.href, window.location.href);
                            if (url.origin !== window.location.origin) return;

                            // Ignore same-page hash navigation.
                            if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) {
                                return;
                            }

                            sessionStorage.setItem(navLoaderKey, '1');
                            showLoader();
                        });

                        window.addEventListener('pageshow', function (event) {
                            if (event.persisted) {
                                hideLoader();
                            }
                        });
                    })();
                </script>
            </body>

        </html>

                            <label class="form-label">จำนวนครั้ง/ผู้ใช้ 1 คน</label>
                            <input type="number" min="0" class="form-control" asp-for="EditPromotionForm.MaxRedemptionsPerUser" id="editMaxRedemptionsPerUser">

        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-pen-to-square me-2"></i>แก้ไขโปรโมชัน</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editPromotionForm" asp-controller="BackOffice" asp-action="UpdatePromotion" method="post">
                    <input type="hidden" asp-for="EditPromotionForm.PromotionId" id="editPromotionId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Promo Code</label>
                            <input type="text" class="form-control" asp-for="EditPromotionForm.PromoCode" id="editPromotionCode" maxlength="30" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ชื่อโปรโมชัน <span class="text-danger">*</span></label>

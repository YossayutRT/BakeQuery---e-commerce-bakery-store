<div class="modal fade bo-theme" id="promotionUsageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-chart-bar me-2"></i>สถิติการใช้งานโปรโมชั่น</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
                    <div><strong>โปรโมชั่น:</strong> <span id="usagePromoName">-</span></div>
                    <div><strong>รหัส:</strong> <span id="usagePromoCode" class="code-badge">-</span></div>
                    <div><strong>จำนวนครั้งที่ใช้รวม:</strong> <span id="usageTotalCount">0</span></div>
                    <div><strong>ผู้ใช้ที่เคยใช้:</strong> <span id="usageUserCount">0</span> คน</div>
                </div>

                <div id="usageLoading" class="text-muted">กำลังโหลดข้อมูล...</div>
                <div id="usageError" class="text-danger d-none"></div>

                <div class="table-responsive">
                    <table class="products-table" id="usageTable">
                        <thead>
                            <tr>
                                <th>รหัสผู้ใช้</th>
                                <th>ชื่อผู้ใช้</th>
                                <th>อีเมล</th>
                                <th class="text-end">ใช้ไป (ครั้ง)</th>
                                <th class="text-end">ส่วนลดรวม (บาท)</th>
                                <th>ใช้ล่าสุด</th>
                            </tr>
                        </thead>
                        <tbody id="usageTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted">ยังไม่มีข้อมูล</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const editModalElement = document.getElementById("editPromotionModal");
        if (!editModalElement) {
            return;
        }

        editModalElement.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            document.getElementById("editPromotionId").value = button.getAttribute("data-promotion-id") || "";
            document.getElementById("editPromotionCode").value = button.getAttribute("data-promo-code") || "";
            document.getElementById("editPromotionName").value = button.getAttribute("data-name") || "";
            document.getElementById("editPromotionType").value = button.getAttribute("data-promo-type") || "PERCENT";
            document.getElementById("editPromotionStartAt").value = button.getAttribute("data-start-at") || "";
            document.getElementById("editPromotionEndAt").value = button.getAttribute("data-end-at") || "";
            document.getElementById("editPromotionDescription").value = button.getAttribute("data-description") || "";
            document.getElementById("editPromotionIsActive").checked = (button.getAttribute("data-is-active") || "false") === "true";
            document.getElementById("editMinOrderAmount").value = button.getAttribute("data-min-order-amount") || "";
            document.getElementById("editDiscountPercent").value = button.getAttribute("data-discount-percent") || "";
            document.getElementById("editDiscountAmount").value = button.getAttribute("data-discount-amount") || "";
            document.getElementById("editBuyQty").value = button.getAttribute("data-buy-qty") || "";
            document.getElementById("editFreeQty").value = button.getAttribute("data-free-qty") || "";
            document.getElementById("editFreeProductId").value = button.getAttribute("data-free-product-id") || "";
            document.getElementById("editMemberOnly").checked = (button.getAttribute("data-member-only") || "false") === "true";
            document.getElementById("editMaxRedemptions").value = button.getAttribute("data-max-redemptions") || "";
            document.getElementById("editMaxRedemptionsPerUser").value = button.getAttribute("data-max-redemptions-per-user") || "";
        });

        const usageModalElement = document.getElementById("promotionUsageModal");
        if (!usageModalElement) {
            return;
        }

        usageModalElement.addEventListener("show.bs.modal", async function (event) {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            const promotionId = button.getAttribute("data-promotion-id") || "";
            const promoCode = button.getAttribute("data-promo-code") || "-";
            const promoName = button.getAttribute("data-promo-name") || "-";

            const usagePromoName = document.getElementById("usagePromoName");
            const usagePromoCode = document.getElementById("usagePromoCode");
            const usageTotalCount = document.getElementById("usageTotalCount");
            const usageUserCount = document.getElementById("usageUserCount");
            const usageTableBody = document.getElementById("usageTableBody");
            const usageLoading = document.getElementById("usageLoading");
            const usageError = document.getElementById("usageError");

            usagePromoName.textContent = promoName;
            usagePromoCode.textContent = promoCode;
            usageTotalCount.textContent = "0";
            usageUserCount.textContent = "0";
            usageTableBody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">กำลังโหลดข้อมูล...</td></tr>';
            usageLoading.classList.remove("d-none");
            usageError.classList.add("d-none");
            usageError.textContent = "";

            try {
                const response = await fetch(`/BackOffice/GetPromotionUsage?promotionId=${encodeURIComponent(promotionId)}`, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    throw new Error("ไม่สามารถโหลดข้อมูลการใช้งานโปรโมชั่นได้");
                }

                const result = await response.json();
                const rows = result.usageByUser || [];

                usagePromoName.textContent = result.promotion?.name || promoName;
                usagePromoCode.textContent = result.promotion?.promoCode || promoCode;
                usageTotalCount.textContent = String(result.totalRedemptions || 0);
                usageUserCount.textContent = String(result.uniqueUsers || 0);

                if (rows.length === 0) {
                    usageTableBody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">ยังไม่มีผู้ใช้โปรโมชั่นนี้</td></tr>';
                } else {
                    usageTableBody.innerHTML = rows.map(row => `
                        <tr>
                            <td>${row.userCode ?? "-"}</td>
                            <td>${row.fullName ?? "-"}</td>
                            <td>${row.email ?? "-"}</td>
                            <td class="text-end">${row.useCount ?? 0}</td>
                            <td class="text-end">฿${Number(row.totalDiscount ?? 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                            <td>${row.lastUsedAt ?? "-"}</td>
                        </tr>
                    `).join("");
                }
            } catch (error) {
                usageError.textContent = error instanceof Error ? error.message : "เกิดข้อผิดพลาดในการโหลดข้อมูล";
                usageError.classList.remove("d-none");
                usageTableBody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">โหลดข้อมูลไม่สำเร็จ</td></tr>';
            } finally {
                usageLoading.classList.add("d-none");
            }
        });
    });
</script>

                            <input type="datetime-local" class="form-control" asp-for="EditPromotionForm.StartAt" id="editPromotionStartAt" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">วันสิ้นสุด <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" asp-for="EditPromotionForm.EndAt" id="editPromotionEndAt" required>

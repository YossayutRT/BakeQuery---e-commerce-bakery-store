@model _66033872_Yossayut_rutatip.ViewModels.DashboardViewModel

@{
    Layout = "_BackOfficeLayout";
    ViewData["Title"] = "Dashboard";

    var trendLabels = Model.SalesTrend.Select(x => x.Label).ToList();
    var trendAmounts = Model.SalesTrend.Select(x => x.Amount).ToList();
    var roleLabels = Model.UserRoleDistribution.Select(x => x.RoleName).ToList();
    var roleCounts = Model.UserRoleDistribution.Select(x => x.UserCount).ToList();
    var roleColors = Model.UserRoleDistribution.Select(x => x.ColorHex).ToList();
}

<link rel="stylesheet" href="~/css/BackOfficeOrderTheme.css" />

<section class="dashboard-shell container-fluid p-4 bo-theme">
    <div class="dash-head mb-4">
        <h2 class="h3 mb-1">Dashboard ภาพรวมร้าน</h2>
        <div class="text-muted">โทนข้อมูลยอดขายจริงจากระบบ พร้อมดูเทรนด์รายวันและสินค้าขายดี</div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="card metric-card metric-card-day h-100">
                <div class="card-body">
                    <div class="metric-label">ยอดขายวันนี้</div>
                    <div class="metric-value">฿@Model.SalesToday.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card metric-card metric-card-month h-100">
                <div class="card-body">
                    <div class="metric-label">ยอดขายเดือนนี้</div>
                    <div class="metric-value">฿@Model.SalesThisMonth.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-12">
            <div class="card metric-card metric-card-year h-100">
                <div class="card-body">
                    <div class="metric-label">ยอดขายปีนี้</div>
                    <div class="metric-value">฿@Model.SalesThisYear.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card dash-card mb-4">
        <div class="card-header dash-card-header">
            <h6 class="mb-0">กราฟเส้นยอดขายย้อนหลัง 14 วัน</h6>
        </div>
        <div class="card-body">
            <div class="sales-chart-wrap">
                <canvas id="salesLineChart"></canvas>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card dash-card h-100">
                <div class="card-header dash-card-header">
                    <h6 class="mb-0">สินค้าขายดี (อิงจำนวนชิ้นที่ขายได้)</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 bestseller-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">อันดับ</th>
                                    <th>สินค้า</th>
                                    <th class="text-end">ขายได้ (ชิ้น)</th>
                                    <th class="text-end">ยอดขาย</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TopSellingProducts.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">ยังไม่มียอดขาย</td>
                                    </tr>
                                }
                                else
                                {
                                    @for (var i = 0; i < Model.TopSellingProducts.Count; i++)
                                    {
                                        var item = Model.TopSellingProducts[i];
                                        <tr>
                                            <td><span class="rank-badge">#@(i + 1)</span></td>
                                            <td>@item.ProductName</td>
                                            <td class="text-end">@item.QuantitySold</td>
                                            <td class="text-end">฿@item.Revenue.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card dash-card h-100">
                <div class="card-header dash-card-header">
                    <h6 class="mb-0">จำนวนผู้ใช้แยกตาม Role</h6>
                </div>
                <div class="card-body">
                    <div style="height: 280px;">
                        <canvas id="roleChart"></canvas>
                    </div>
                    <div class="mt-3">
                        @foreach (var role in Model.UserRoleDistribution)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span style="width:12px;height:12px;border-radius:50%;display:inline-block;background-color:@role.ColorHex;"></span>
                                    <span>@role.RoleName</span>
                                </div>
                                <strong>@role.UserCount</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .dash-head h2 {
        color: #2f241c;
        font-weight: 700;
    }

    .metric-card {
        border: 1px solid #eee7dd;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(47, 36, 28, 0.04);
    }

    .metric-card-day {
        border-left: 6px solid #8c5f37;
    }

    .metric-card-month {
        border-left: 6px solid #b07a45;
    }

    .metric-card-year {
        border-left: 6px solid #cf8f45;
    }

    .metric-label {
        color: #8f7f6f;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .2px;
        margin-bottom: 6px;
        font-weight: 700;
    }

    .metric-value {
        color: #2f241c;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .dash-card {
        border: 1px solid #eee7dd;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(47, 36, 28, 0.04);
    }

    .dash-card-header {
        background: #faf8f4;
        color: #2f241c;
        border-bottom: 1px solid #e6ddcf;
        font-weight: 700;
    }

    .sales-chart-wrap {
        height: 360px;
    }

    .rank-badge {
        display: inline-flex;
        border-radius: 999px;
        background: #2f241b;
        color: #fff;
        font-weight: 700;
        font-size: .72rem;
        padding: 4px 10px;
    }

    .bestseller-table th {
        color: #7f6a55;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .3px;
        border-bottom-color: #ebdecd;
    }

    .bestseller-table td {
        border-bottom-color: #f1e7da;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendLabels));
        var trendAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendAmounts));

        var salesLineElement = document.getElementById("salesLineChart");
        if (salesLineElement) {
            new Chart(salesLineElement, {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: 'ยอดขาย (บาท)',
                        data: trendAmounts,
                        tension: 0.35,
                        borderColor: '#8c5f37',
                        backgroundColor: 'rgba(140, 95, 55, 0.14)',
                        fill: true,
                        borderWidth: 3,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#6f4d34'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(186, 150, 108, 0.15)'
                            },
                            ticks: {
                                color: '#7a6450'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(186, 150, 108, 0.15)'
                            },
                            ticks: {
                                color: '#7a6450'
                            }
                        }
                    }
                }
            });
        }

        var chartElement = document.getElementById("roleChart");
        if (!chartElement) {
            return;
        }

        var roleLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleLabels));
        var roleCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleCounts));
        var roleColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleColors));

        new Chart(chartElement, {
            type: 'doughnut',
            data: {
                labels: roleLabels,
                datasets: [{
                    data: roleCounts,
                    backgroundColor: roleColors,
                    borderWidth: 2
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    });
</script>
